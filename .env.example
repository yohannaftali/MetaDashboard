# Optional: the accounts are normally entered in the app (uv run metadashboard, Settings).
# A .env is imported once into an empty data/metadashboard.db; delete it afterwards. Never commit .env.
# Investor (read-only) passwords only.

# terminal64.exe used ONLY for monitoring (a portable copy, e.g. C:\MT5-Monitor\terminal64.exe).
# Logging in switches that terminal's account: never point this at a terminal that runs live EAs.
MT5_TERMINAL_PATH=C:\MT5-Monitor\terminal64.exe

# One block per account: PREFIX_MT5_LOGIN / _SERVER / _INVESTOR_PASSWORD, optional PREFIX_NAME
VANTAGE_NAME=Vantage
VANTAGE_MT5_LOGIN=12345678
VANTAGE_MT5_SERVER=VantageInternational-Live 3
VANTAGE_MT5_INVESTOR_PASSWORD=your-investor-password

EXNESS_NAME=Exness
EXNESS_MT5_LOGIN=12345678
EXNESS_MT5_SERVER=Exness-MT5Real15
EXNESS_MT5_INVESTOR_PASSWORD=your-investor-password
